ue, "secondary": false, "min_rarity": "rare", "category": "structural", "harmful": true}}, {"value": "knock_prone", "name_zh": "擊倒", "description_zh": "對抗判定（技能的縮放屬性 vs 目標同屬性），成功才倒地。", "params": [{"field": "affects", "name_zh": "對象", "description_zh": "省略時用原語的預設對象", "type": "choice", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "enemies", "name_zh": "敵方", "description_zh": "影響範圍內的敵方單位", "params": [], "info": {}}, {"value": "allies", "name_zh": "友方", "description_zh": "影響範圍內的友方單位（含自己，依形狀而定）", "params": [], "info": {}}, {"value": "all", "name_zh": "敵我不分", "description_zh": "影響範圍內的所有單位", "params": [], "info": {}}, {"value": "self", "name_zh": "自己", "description_zh": "只作用在施放者自己", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": "enemies", "card": false, "object_choice": false}], "info": {"core": true, "secondary": false, "min_rarity": "rare", "category": "structural", "harmful": true}}, {"value": "dash", "name_zh": "衝鋒", "description_zh": "施放者沿最短可走路徑（步行規則；不經過任何單位）移到目標單位的相鄰格（路徑成本不超過技能射程；不消耗移動點數），再結算同技能的其餘效果。一律最先結算，必須是技能的第一個效果。途中會觸發藉機攻擊與陷阱；被擋下（定身、倒地、倒下）或停下時目標不在相鄰格，其餘效果不結算。算「本回合移動過」，也觸發 on_move 被動。只能搭配形狀 single（目標單位）。", "params": [{"field": "affects", "name_zh": "對象", "description_zh": "省略時用原語的預設對象", "type": "choice", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "self", "name_zh": "自己", "description_zh": "只作用在施放者自己", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": "self", "card": false, "object_choice": false}], "info": {"core": false, "secondary": true, "min_rarity": "rare", "category": "structural", "harmful": true}}, {"value": "shadowstep", "name_zh": "瞬步", "description_zh": "以射程內看得到的一個敵方單位為目標，施放者瞬間出現在他相鄰的格子（不經過中間的格子、不觸發藉機攻擊，也不觸發「敵人走進相鄰格」與監視射擊；不墜落），落地後面向目標。landing：choose 一般瞬步（形狀 unit_then_tile，兩段選取：敵人 → 他相鄰的空格，玩家自選）；behind 瞬步背刺類（形狀 single，固定落在目標的背後格；被占住或不可站立時改為目標相鄰的其他空格——先左右兩側、再正面，同距離依上、右、下、左的順序；都沒有就不能施放）。落點須可站立、沒有單位、不是致命地形，與目標的高度差不超過近戰上限。落點的陷阱與表面照常結算。之後的效果以落點結算，所以接在後面的近戰傷害會吃到背刺加成。不算「本回合移動過」，不觸發 on_move 被動。必須是技能的第一個效果；定身或倒地時不能施放。", "params": [{"field": "affects", "name_zh": "對象", "description_zh": "省略時用原語的預設對象", "type": "choice", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "self", "name_zh": "自己", "description_zh": "只作用在施放者自己", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": "self", "card": false, "object_choice": false}, {"field": "landing", "name_zh": "落點", "description_zh": "choose 玩家自選目標相鄰的空格；behind 固定落在目標的背後格", "type": "choice", "required": true, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "choose", "name_zh": "自選落點", "description_zh": "形狀 unit_then_tile：先選敵人，再選他相鄰的空格", "params": [], "info": {}}, {"value": "behind", "name_zh": "背後", "description_zh": "形狀 single：固定落在目標背後", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}], "info": {"core": true, "secondary": false, "min_rarity": "rare", "category": "structural", "harmful": true}}, {"value": "swap", "name_zh": "交換位置", "description_zh": "施放者與目標單位（敵我皆可）交換位置。對敵人（affects 為 enemies）要過一般位移檢定（對抗判定：技能的縮放屬性 vs 目標同屬性；抵抗成功則不交換），不再另外擲命中；對友方（affects 為 allies）自動成功。不能和自己交換。交換後雙方的落點互動（表面、陷阱、致命地形、墜落）照常結算。不算「本回合移動過」，不觸發 on_move 被動。", "params": [{"field": "affects", "name_zh": "對象", "description_zh": "省略時用原語的預設對象", "type": "choice", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "enemies", "name_zh": "敵方", "description_zh": "影響範圍內的敵方單位", "params": [], "info": {}}, {"value": "allies", "name_zh": "友方", "description_zh": "影響範圍內的友方單位（含自己，依形狀而定）", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": "allies", "card": false, "object_choice": false}], "info": {"core": true, "secondary": false, "min_rarity": "rare", "category": "structural", "harmful": false}}, {"value": "apply_status", "name_zh": "施加狀態", "description_zh": "施加 statuses.yaml 中的狀態，重複施加時刷新持續時間。", "params": [{"field": "affects", "name_zh": "對象", "description_zh": "省略時用原語的預設對象", "type": "choice", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "enemies", "name_zh": "敵方", "description_zh": "影響範圍內的敵方單位", "params": [], "info": {}}, {"value": "allies", "name_zh": "友方", "description_zh": "影響範圍內的友方單位（含自己，依形狀而定）", "params": [], "info": {}}, {"value": "all", "name_zh": "敵我不分", "description_zh": "影響範圍內的所有單位", "params": [], "info": {}}, {"value": "self", "name_zh": "自己", "description_zh": "只作用在施放者自己", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": "enemies", "card": false, "object_choice": false}, {"field": "status", "name_zh": "狀態", "description_zh": "", "type": "choice", "required": true, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "defending", "name_zh": "防禦", "description_zh": "防禦值 +25%，持續到自己的下回合開始。", "params": [], "info": {"beneficial": true, "stance": false, "min_rarity": "common"}}, {"value": "prone", "name_zh": "倒地", "description_zh": "移動前要先站起來（消耗一半移動點數）；近戰攻擊倒地者有優勢，遠程攻擊有劣勢。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "rare"}}, {"value": "burning", "name_zh": "燃燒", "description_zh": "回合開始時受到 1d6 火焰傷害，持續 2 回合；重複施加時刷新持續時間。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "common"}}, {"value": "concealed", "name_zh": "隱蔽", "description_zh": "對其攻擊有劣勢；超過 2 格的遠程攻擊無法選為目標。站在黑暗表面或草叢中的單位也視為隱蔽。", "params": [], "info": {"beneficial": true, "stance": false, "min_rarity": "rare"}}, {"value": "revealed", "name_zh": "被揭露", "description_zh": "不算隱蔽（黑暗與草叢也一樣），也不能再獲得隱蔽。只能由揭露（reveal）施加。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "common"}}, {"value": "overwatch", "name_zh": "監視", "description_zh": "持續到自己的下回合開始。期間敵人在武器射程與視線內完成一步移動，就自動普攻一次（佔本輪反應，不花 AP），射擊後監視結束。", "params": [], "info": {"beneficial": true, "stance": false, "min_rarity": "rare"}}, {"value": "time_bomb", "name_zh": "定時炸彈", "description_zh": "身上綁著定時炸彈，剩餘回合就是倒數（每次環境回合 −1）：歸零時在身體當下的位置爆炸，波及周圍；倒下時也會立即爆炸。可被淨化移除，驅散不移除。只能由定時炸彈（delayed_damage）施加。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "common"}}, {"value": "slow", "name_zh": "緩速", "description_zh": "回合開始時的移動點數減半（無條件捨去）。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "common"}}, {"value": "root", "name_zh": "定身", "description_zh": "不能主動移動（仍可被推擊、拉扯等強制位移）。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "rare"}}, {"value": "stun", "name_zh": "暈眩", "description_zh": "跳過整個回合：沒有 AP、移動點數與反應。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "rare"}}, {"value": "frozen", "name_zh": "冰凍", "description_zh": "跳過整個回合（同暈眩，與暈眩共用硬控的控制遞減）；受到火焰傷害時立即解除。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "rare"}}, {"value": "weaken", "name_zh": "虛弱", "description_zh": "自己造成的攻擊傷害 ×75%。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "common"}}, {"value": "vulnerable", "name_zh": "易傷", "description_zh": "受到的骰值傷害 ×125%（不含墜落、致命地形等百分比傷害）。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "common"}}, {"value": "bleed", "name_zh": "流血", "description_zh": "回合開始時受到 1d4 物理傷害，持續 3 回合。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "common"}}, {"value": "poison", "name_zh": "中毒", "description_zh": "回合開始時受到 1d4 毒素傷害，持續 3 回合；受到的治療減半。", "params": [], "info": {"beneficial": false, "stance": false, "min_rarity": "common"}}, {"value": "guarded", "name_zh": "護衛", "description_zh": "受到的骰值傷害 ×70%（不含墜落、致命地形等百分比傷害）。", "params": [], "info": {"beneficial": true, "stance": false, "min_rarity": "common"}}, {"value": "empo