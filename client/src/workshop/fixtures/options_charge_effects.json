_choice": false}, {"field": "duration", "name_zh": "持續回合", "description_zh": "", "type": "int", "required": false, "min": 1, "max": 10, "allow_weapon": false, "dice_sides": [], "choices": [], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}], "info": {"core": false, "secondary": true, "min_rarity": "common", "category": "numeric", "harmful": true}}, {"value": "create_surface", "name_zh": "產生表面", "description_zh": "在影響格產生表面（先查互動表，例如水熄滅火）；表面記錄施放者陣營。", "params": [{"field": "affects", "name_zh": "對象", "description_zh": "省略時用原語的預設對象", "type": "choice", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "enemies", "name_zh": "敵方", "description_zh": "影響範圍內的敵方單位", "params": [], "info": {}}, {"value": "allies", "name_zh": "友方", "description_zh": "影響範圍內的友方單位（含自己，依形狀而定）", "params": [], "info": {}}, {"value": "all", "name_zh": "敵我不分", "description_zh": "影響範圍內的所有單位", "params": [], "info": {}}, {"value": "self", "name_zh": "自己", "description_zh": "只作用在施放者自己", "params": [], "info": {}}, {"value": "tiles", "name_zh": "格子", "description_zh": "作用在影響範圍內的格子", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": "tiles", "card": false, "object_choice": false}, {"field": "surface", "name_zh": "表面", "description_zh": "", "type": "choice", "required": true, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "oil", "name_zh": "油", "description_zh": "", "params": [], "info": {"beneficial": false}}, {"value": "water", "name_zh": "水", "description_zh": "", "params": [], "info": {"beneficial": false}}, {"value": "fire", "name_zh": "火焰", "description_zh": "", "params": [], "info": {"beneficial": false}}, {"value": "ice", "name_zh": "冰", "description_zh": "", "params": [], "info": {"beneficial": false}}, {"value": "poison", "name_zh": "毒", "description_zh": "", "params": [], "info": {"beneficial": false}}, {"value": "holy", "name_zh": "聖光", "description_zh": "", "params": [], "info": {"beneficial": true}}, {"value": "darkness", "name_zh": "黑暗", "description_zh": "", "params": [], "info": {"beneficial": false}}], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}, {"field": "duration", "name_zh": "持續回合", "description_zh": "", "type": "int", "required": false, "min": 1, "max": 10, "allow_weapon": false, "dice_sides": [], "choices": [], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}], "info": {"core": false, "secondary": true, "min_rarity": "rare", "category": "structural", "harmful": false}}, {"value": "topple", "name_zh": "推倒", "description_zh": "推倒目標（射程內看得到的 topplable 物件，技能只能以物件為目標），往遠離施放者的方向倒下：從下一格起壓住 topple_length 格（rules/core.yaml），壓到的單位受 topple_damage_dice 物理傷害並倒地、壓到的 breakable 物件受同樣傷害，其他物件擋住倒下；原物件移除，最後一格產生倒塌物。互動的推、技能的推擊與風推到 topplable 物件時也一樣會推倒它（通用規則）。", "params": [{"field": "affects", "name_zh": "對象", "description_zh": "省略時用原語的預設對象", "type": "choice", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "enemies", "name_zh": "敵方", "description_zh": "影響範圍內的敵方單位", "params": [], "info": {}}, {"value": "allies", "name_zh": "友方", "description_zh": "影響範圍內的友方單位（含自己，依形狀而定）", "params": [], "info": {}}, {"value": "all", "name_zh": "敵我不分", "description_zh": "影響範圍內的所有單位", "params": [], "info": {}}, {"value": "self", "name_zh": "自己", "description_zh": "只作用在施放者自己", "params": [], "info": {}}, {"value": "tiles", "name_zh": "格子", "description_zh": "作用在影響範圍內的格子", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": "tiles", "card": false, "object_choice": false}], "info": {"core": true, "secondary": false, "min_rarity": "rare", "category": "structural", "harmful": true}}], "fields": [], "min_count": 1, "max_count": 4, "default": null, "card": false, "object_choice": false}], "notes_zh": ["至少 1 個核心效果（push、pull、teleport、knock_prone、hurl_object、topple、leap、swap、teleport_target、swap_any、charge_through、shadowstep）；附帶效果最多 2 個", "效果總數最多 4 個；普通稀有度最多 2 個", "damage 的點數最多占 50%", "互斥規則「無冷卻的大範圍」：沒有冷卻的技能不得使用 square3、allies_in_radius、ring 半徑 2、cone 大小 4", "互斥規則「暈眩的限制」：施加 stun 或 frozen（硬控）的技能形狀只能是 single，且冷卻至少 4 回合", "互斥規則「推拉不並存」：同一技能不得同時有 push 與 pull", "互斥規則「自身形狀不打敵人」：self 形狀不得有對象為 enemies 的效果", "互斥規則「傷害與友方治療不並存」：同一技能不得同時有對敵方的 damage 與對友方的 heal（屬於不同骨架）；吸血（lifesteal_permille）與聖光雙效（split_heal）不在此限", "互斥規則「同類控制不重複」：同一技能不得施加兩個相同 control_group 的狀態"]}], "next_step": "effects", "problems": []}