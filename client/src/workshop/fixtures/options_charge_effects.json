ription_zh": "", "type": "choice", "required": true, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "missing_hp_10pct", "name_zh": "施放者每少 10% 最大 HP", "description_zh": "", "params": [], "info": {}}, {"value": "distance", "name_zh": "與目標每距 1 格", "description_zh": "", "params": [], "info": {}}, {"value": "enemies_adjacent_target", "name_zh": "目標相鄰的每個敵人", "description_zh": "", "params": [], "info": {}}, {"value": "enemies_adjacent_self", "name_zh": "施放者相鄰的每個敵人", "description_zh": "", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}, {"field": "per_step_permille", "name_zh": "每一步加成（‰）", "description_zh": "", "type": "int", "required": true, "min": 1, "max": 1000, "allow_weapon": false, "dice_sides": [], "choices": [], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}, {"field": "cap_permille", "name_zh": "加成上限（‰）", "description_zh": "", "type": "int", "required": true, "min": 1, "max": 800, "allow_weapon": false, "dice_sides": [], "choices": [], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}, {"field": "lifesteal_permille", "name_zh": "吸血（‰）", "description_zh": "吸血（Phase 3D-8a）：施放者回復這個效果對敵人實際造成的傷害（扣掉護盾吸收，含溢出）× n‰（無條件捨去，不超過最大 HP）；用 heal 事件、原因 lifesteal；只有技能自己的傷害效果可以用；預算：傷害點數 × (1 ＋ n‰ × lifesteal_value_permille)", "type": "int", "required": false, "min": 1, "max": 500, "allow_weapon": false, "dice_sides": [], "choices": [], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}, {"field": "on_kill", "name_zh": "擊殺時效果", "description_zh": "技能內的擊殺時效果（Phase 3D-8b）：這個傷害效果讓敵人倒下時才結算的 1–2 個效果，對象一律是施放者。可用類型：refund_ap（返還 amount 點 AP，1–2，用專用效果、不受改寫規則限制）、refund_cooldown（本技能冷卻歸零，技能必須有 cost.cooldown）、heal、shield、apply_status（一般原語）。同一個傷害效果讓一個以上的敵人倒下只結算一次；施放者自己在結算中倒下則不結算。只有主動技能自己的傷害效果可以用。預算：on_kill 各效果的點數 × on_kill_expected_permille（預估擊殺率）", "type": "effects", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}, {"field": "split_heal", "name_zh": "聖光雙效", "description_zh": "聖光雙效（Phase 3D-8a）：必須搭配 affects: all、主動法術技、aura 或 area 骨架，不可與 lifesteal、explode、scaling 並用。敵方依一般命中判定受到傷害、友方（含自己）不擲命中而治療同樣的骰值（骰一次，治療量 ＝ 骰值 ＋ 縮放屬性 × 0.5，受治療倍率影響）；預算傷害與治療兩邊都計；只能填 true", "type": "bool", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [], "fields": [], "min_count": null, "max_count": null, "default": null, "card": false, "object_choice": false}], "info": {"core": false, "secondary": true, "min_rarity": "common", "category": "numeric", "harmful": true}}, {"value": "push", "name_zh": "推擊", "description_zh": "以施放者（中心格型為中心）為原點往外推；被擋住時停在擋住前的格子，steadfast 減半。", "params": [{"field": "affects", "name_zh": "對象", "description_zh": "省略時用原語的預設對象", "type": "choice", "required": false, "min": null, "max": null, "allow_weapon": false, "dice_sides": [], "choices": [{"value": "enemies", "name_zh": "敵方", "description_zh": "影響範圍內的敵方單位", "params": [], "info": {}}, {"value": "allies", "name_zh": "友方", "description_zh": "影響範圍內的友方單位（含自己，依形狀而定）", "params": [], "info": {}}, {"value": "all", "name_zh": "敵我不分", "description_zh": "影響範圍內的所有單位", "params": [], "info": {}}, {"value": "self", "name_zh": "自己", "description_zh": "只作用在施放者自己", "params": [], "info": {}}], "fields": [], "min_count": null, "max_count": null, "default": "enemies", "card": false, "object_choice": false}, {"field": "distance", "name_zh": "距離（格）", "description_zh": "", "type": "int", "required": true, "min": 1, "max": 2, "allow_weapon": false, "dice_sides": [], "choices": [], "fields": [], "min_count": null, "max_count": null, "default":